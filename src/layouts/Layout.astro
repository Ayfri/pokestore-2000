---
import { Font, Image } from "astro:assets";
import banner from "../assets/montages/header.webp";
import Badges from "../components/Badges.astro";
import CartCount from "../components/CartCount.svelte";
import Gif from "../components/Gif.astro";
import HitCounter from "../components/HitCounter.svelte";
import MidiPlayer from "../components/MidiPlayer.svelte";
import { type Sprite, y2k } from "../data";
import "../styles.css";

interface Props {
	title: string;
}

type Link = [href: string, label: string, sprite: Sprite];

const { title } = Astro.props;
/** With build.format "file" the build-time pathname is /shop.html or /index.html, while dev serves /shop and /. */
const path = Astro.url.pathname.replace(/(index)?\.html$/, "");
const description = "Welcome to Pokéstore 2000! The #1 place on the web for rare and collectible Pokémon cards.";
const nav: Link[] = [
	["/", "Home", "pikachu"],
	["/shop", "Cards", "pokeball"],
	["/goodies", "Boosters & Goodies", "ultraball"],
	["/order-info", "How to Order", "greatball"],
	["/guestbook", "Guestbook", "mew"],
	["/about", "About", "jigglypuff"],
	["/links", "Cool Links", "staryu"],
	["/gifs", "GIF Gallery", "pichu"],
];
const fun: Link[] = [
	["/whos-that", "Who's That Pokémon?", "ditto"],
	["/quiz", "Which Pokémon R U?", "eevee"],
	["/rumors", "Secrets & Rumors", "gengar"],
	["/downloads", "Downloads", "porygon"],
	["/link-to-us", "Link to Us!", "abra"],
];
/** The webring is the site's own pages: prev/next walk the nav, "random" is picked once per page at build time, no script needed. */
const ring = [...nav, ...fun].map(([href]) => href);
const index = Math.max(ring.indexOf(path), 0);
const others = ring.filter(href => href !== path);
const random = others[Math.floor(Math.random() * others.length)];
/** "Last updated" is the build date, moved to 2000 like every other date on the site. */
const updated = y2k().toLocaleDateString("en-US", { month: "2-digit", day: "2-digit", year: "numeric" });
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} - Pokéstore 2000</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={`${title} - Pokéstore 2000`} />
		<meta property="og:description" content={description} />
		<meta name="theme-color" content="#000080" />
		<link rel="icon" href="/gifs/pokeball.gif" />
		<Font cssVariable="--font-comic-neue" />
		<Font cssVariable="--font-vt323" />
		<Font cssVariable="--font-silkscreen" />
		<Font cssVariable="--font-titan-one" />
	</head>
	<body>
		<div class="mx-auto max-w-[966px] border border-black bg-[#0a0a3c]">
			<header>
				<a href="/"><Image src={banner} alt="Pokéstore 2000 - Your #1 source for rare Pokémon cards" width={964}format="avif" quality={90} loading="eager" fetchpriority="high" class="block h-auto w-full" /></a>
				<div class="flex items-center justify-between gap-2 border-y border-black bg-linear-to-b from-[#2b3f9e] to-[#0d1a5c] px-2 py-1 font-pixel text-[8px] text-white">
					<span id="clock"></span>
					<a href="/cart" class="text-yellow-300 no-underline visited:text-yellow-300">» MY CART (<CartCount client:only="svelte" />)</a>
				</div>
				<marquee scrollamount="4" class="block border-b border-black bg-black py-0.5 text-[11px] text-yellow-300">
					<b>HOT DEAL:</b> buy any Charizard card and get a free Magikarp! &nbsp;&nbsp;&nbsp; Gold & Silver are out now in the USA! &nbsp;&nbsp;&nbsp; Neo Genesis pre-orders are open!
				</marquee>
			</header>

			<div class="flex flex-col sm:flex-row">
				<aside class="shrink-0 border-black p-2 sm:w-44 sm:border-r [&_.logo-text]:mt-3 [&_.logo-text]:mb-1 [&_.logo-text]:text-lg [&_.logo-text]:first:mt-0">
					<nav>
						<p class="logo-text">Navigation</p>
						<ul>
							{nav.map(([href, label, sprite]) => (
								<li><a {href} class="side-link" aria-current={path === href ? "page" : undefined}><Gif name={sprite} class="h-4" />{label}</a></li>
							))}
						</ul>
						<p class="logo-text">Fun Zone</p>
						<ul>
							{fun.map(([href, label, sprite]) => (
								<li>
									<a {href} class="side-link" aria-current={path === href ? "page" : undefined}><Gif name={sprite} class="h-4" />{label}</a>
									{href === "/whos-that" && <span class="ml-5 bg-red-600 px-0.5 font-pixel text-[8px] text-white">NEW</span>}
								</li>
							))}
						</ul>
					</nav>
					<p class="logo-text">Site Info</p>
					<div class="text-[11px] text-white">
						<p>You are visitor #</p>
						<HitCounter client:only="svelte"><HitCounter slot="fallback" /></HitCounter>
						<p class="mt-1 text-[#99a]">Updated {updated}</p>
					</div>
				</aside>

				<main class="min-w-0 flex-1 bg-white p-3">
					<h1 class="logo-text mb-3 text-[26px] leading-tight">{title}</h1>
					<slot />
				</main>
			</div>

			<footer class="border-t border-black bg-[#e8ebf7] p-3 text-center text-[11px]">
				<p class="mb-2 flex flex-wrap items-center justify-center gap-2">
					<a href={ring[(index - 1 + ring.length) % ring.length]}>&lt;&lt; Prev</a> |
					<span><Gif name="mew" class="inline h-4" /> <b>PokéWebRing</b></span> |
					<a href={random}>Random</a> |
					<a href={ring[(index + 1) % ring.length]}>Next &gt;&gt;</a>
				</p>
				<MidiPlayer client:idle />
				<Badges />
				<p class="mt-3">
					<a href="mailto:webmaster@pokestore-2000.com">E-mail the webmaster</a> - ICQ: 48271936 - AIM: PokeStore2000
				</p>
				<p class="mt-1 text-gray-600">
					© 2000 Pokéstore. Pokémon and all related characters are © Nintendo / Game Freak. Pokéstore is not affiliated with Nintendo.<br />
					Best viewed with Internet Explorer 5 at 1024x768. Your screen: <span id="screen">1024x768</span><br />
					Made with Notepad by <a href="https://github.com/Ayfri">Ayfri</a> - Graphics by Gengar_FX - <a href="https://github.com/Ayfri/pokestore-2000">view the source</a>
				</p>
			</footer>
		</div>

		<dialog id="winner" class="win m-auto max-w-sm backdrop:bg-black/40">
			<div class="titlebar"><span>Congratulations!!!.exe</span><form method="dialog"><button class="btn px-1 py-0 text-xs" aria-label="Close">x</button></form></div>
			<div class="flex items-center gap-3 p-4 text-sm">
				<Gif name="masterball" class="h-10" />
				<p><b class="text-red-600">YOU ARE THE 1,000,000th VISITOR!!!</b><br />Click CLAIM NOW to receive your FREE Master Ball!</p>
			</div>
			<form method="dialog" class="flex justify-center gap-2 pb-3">
				<button class="btn" value="claim">CLAIM NOW!</button>
				<button class="btn">No thanks</button>
			</form>
		</dialog>

		<script>
			import "../retro";
		</script>
	</body>
</html>
