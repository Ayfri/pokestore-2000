---
import Downloads from "../components/Downloads.svelte";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Free Downloads!!!">
	<p class="mb-3 notice">
		All downloads are <b>FREE</b> and virus-checked with Norton AntiVirus 2000! Please don't link directly to the files, it eats my bandwidth.
	</p>
	<Downloads client:visible={{ rootMargin: "200px" }} />
	<p class="mt-3 text-center text-[11px] text-gray-600">Download times are for a 56k modem. On 28.8k, double them. On a cable modem, lucky you!!!</p>
</Layout>
