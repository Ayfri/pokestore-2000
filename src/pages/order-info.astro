---
import Gif from "../components/Gif.astro";
import Layout from "../layouts/Layout.astro";

const steps = [
	"Add the cards you want to your <b>Shopping Cart</b>.",
	"Go to the cart and <b>print the page</b> (File &gt; Print in your browser).",
	"Write your name, address and email on the printout.",
	"Mail it with a <b>check or money order</b> payable to <i>Pokéstore 2000</i>. NO CASH please!!",
	"My mom ships every order on Saturday at the post office. You get an email when it's sent!",
];
/** 2000 USPS rates: the first-class stamp was 33 cents and a 2 lb Priority Mail envelope $3.20. */
const shipping = [
	["1-10 cards", "Toploader in an envelope, First Class Mail", "$1.00"],
	["11-50 cards", "Bubble mailer, Priority Mail (2-3 days)", "$3.20"],
	["Boxes / binders", "Priority Mail, box", "$5.50"],
	["Insurance (recommended over $50)", "USPS insurance", "+$0.85"],
	["Canada", "Airmail", "$2.00"],
];
const grades = [
	["Mint", "Perfect! Straight from the pack into a sleeve. No scratches, perfect corners."],
	["Near Mint", "Looks perfect, maybe one tiny white dot on the back. Most of my cards."],
	["Excellent", "Some white on the edges, light scratches on the holo. Was in a binder."],
	["Played", "Someone actually played with this one at school. Still good for decks!"],
];
const faq = [
	["Do you take credit cards?", "Not yet, it's not safe to type your card number on the Internet! Send a check or money order instead."],
	["Are your cards real?", "100% official Wizards of the Coast cards, opened by me. I never sell fakes. Fakes have the wrong font and no shiny back!!"],
	["Do you trade?", "YES! Email me your list. I'm looking for a Japanese Neo Lugia and a 1st Edition Base Set Charizard (I can dream)."],
	["Can I return a card?", "If it arrives damaged, send it back within 2 weeks and I'll refund you or send another one."],
];
---

<Layout title="How to Order">
	<section class="panel mb-3">
		<h3 class="cathead">Ordering is EASY!</h3>
		<div class="p-2">
			<ol class="ml-6 list-decimal space-y-1">{steps.map(step => <li set:html={step} />)}</ol>
			<p class="mt-3 notice">
				Mail to: <b>Pokéstore 2000, P.O. Box 151, Columbus, OH 43215</b><br />
				Orders usually arrive in 4-7 days. Questions? <a href="mailto:webmaster@pokestore-2000.com">webmaster@pokestore-2000.com</a> (I answer after school)
			</p>
		</div>
	</section>

	<section class="panel mb-3">
		<h3 class="cathead">Shipping Rates (USA)</h3>
		<table class="w-full text-left [&_td]:p-2 [&_tbody_tr:nth-child(even)]:bg-row2 [&_tbody_tr:nth-child(odd)]:bg-row1">
			<thead><tr><th class="cathead">Order</th><th class="cathead">How</th><th class="cathead">Price</th></tr></thead>
			<tbody>{shipping.map(([order, how, cost]) => <tr><td>{order}</td><td>{how}</td><td class="font-bold">{cost}</td></tr>)}</tbody>
		</table>
	</section>

	<div class="grid gap-3 md:grid-cols-2">
		<section class="panel">
			<h3 class="cathead">Card Condition Guide</h3>
			<dl class="p-2">{grades.map(([grade, text]) => <><dt class="font-bold text-navy">{grade}</dt><dd class="mb-2 ml-4">{text}</dd></>)}</dl>
		</section>
		<section class="panel">
			<h3 class="cathead">F.A.Q.</h3>
			<div class="p-2">{faq.map(([question, answer]) => <p class="mb-2"><b>Q: {question}</b><br />A: <span set:html={answer} /></p>)}</div>
		</section>
	</div>
	<p class="mt-3 text-center text-[11px] text-gray-600"><Gif name="squirtle" class="inline h-5" /> Safe shopping guaranteed! Pokéstore 2000 never asks for your password or credit card number by email.</p>
</Layout>
