---
import Gif from "../components/Gif.astro";
import type { Sprite } from "../data";
import Layout from "../layouts/Layout.astro";

type Verdict = "REAL" | "FAKE" | "???";

const verdicts: Record<Verdict, string> = {
	REAL: "border-green-700 text-green-700",
	FAKE: "border-red-700 text-red-700",
	"???": "border-yellow-600 text-yellow-600",
};

const rumors: [title: string, text: string, verdict: Verdict, sprite: Sprite][] = [
	[
		"Mew is under the truck!!!",
		"The truck next to the S.S. Anne in Vermilion City. You need to cut a tree with a Pokémon you get later and come back. My cousin's friend's uncle works at Nintendo and SWEARS it's true. I tried with Strength, Surf, everything. Nothing. It's just a truck.",
		"FAKE",
		"mew",
	],
	[
		"MissingNo. clones your items",
		"Talk to the old man in Viridian City, fly to Cinnabar Island and surf up and down the east coast. A glitchy Pokémon called MissingNo. appears and your 6th item gets multiplied to x128! WARNING: it can mess up your Hall of Fame. Do it at your own risk!!! (try the Konami code on this site hehe)",
		"REAL",
		"porygon",
	],
	[
		"Pikablu is coming in Gold/Silver",
		"Everyone saw the pictures of the blue Pikachu with the round tail. UPDATE 10/15/2000: Gold & Silver are out and Pikablu is a water mouse called MARILL. It's not even an electric type. I'm so mad.",
		"REAL",
		"pikachu",
	],
	[
		"Beat the Elite Four 100 times to get Mew",
		"Some kid on the bus said this. I did it 23 times before giving up. Don't waste your summer like me.",
		"FAKE",
		"mewtwo",
	],
	[
		"Hold Down + B to catch Pokémon easier",
		"When you throw a Poké Ball, hold Down and B while it shakes. Nobody can prove it works, but nobody can prove it doesn't! I always do it anyway, just in case.",
		"???",
		"pokeball",
	],
	[
		"PokéGods: Doomsday, Mewthree, Pikablu...",
		"There are tons of pages about secret Pokémon you get by beating the game 50 times or with a GameShark. They are all made up by people with MS Paint. Don't send me your 'proof' screenshots, I know how to use Paint too.",
		"FAKE",
		"gengar",
	],
	[
		"There's a secret Pokémon #251 in Gold/Silver",
		"It's called Celebi and it's a time travel Pokémon! It's in the game code but you can't catch it normally, Nintendo has to give it to you at an event. So it's real but basically impossible. Thanks a lot Nintendo.",
		"REAL",
		"bulbasaur",
	],
	[
		"Bill's secret garden in Pokémon Yellow",
		"Supposedly there's a garden behind Bill's house full of Clefairy. There is no garden. There is a fence. I stared at the fence for an hour.",
		"FAKE",
		"jigglypuff",
	],
];
---

<Layout title="Pokémon Secrets & Rumors">
	<p class="mb-6 border-2 border-dashed border-red-600 bg-white p-3 text-center">
		<Gif name="gengar" /> I tested EVERY rumor on my own Game Boy so you don't have to. Know a rumor I missed?
		<a href="mailto:webmaster@pokestore-2000.com?subject=RUMOR">Email it to me!</a> <Gif name="gengar" />
	</p>
	<div class="grid gap-4">
		{rumors.map(([title, text, verdict, sprite]) => (
			<section class="box relative bg-white">
				<span class:list={["absolute top-2 right-2 rotate-12 border-4 px-2 font-wordart text-2xl [border-style:double]", verdicts[verdict]]}>{verdict}</span>
				<h3 class="mb-2 flex items-center gap-2 pr-20 text-lg font-bold text-navy"><Gif name={sprite} class="h-8" />{title}</h3>
				<p class="text-sm">{text}</p>
			</section>
		))}
	</div>
	<hr />
	<p class="text-center text-sm">People who believed the truck rumor: <b class="font-led text-xl text-red-600">2,874,519</b> (including me)</p>
</Layout>
