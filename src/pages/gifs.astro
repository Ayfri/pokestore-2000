---
import Gif from "../components/Gif.astro";
import { sprites } from "../data";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Pokémon GIF Collection">
	<p class="mb-3 notice">All these GIFs are free to use for your personal website!</p>
	<div class="grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-6">
		{sprites.map(name => (
			<figure class="panel p-2 text-center">
				<Gif name={name} class="mx-auto h-16" />
				<figcaption class="mt-1 text-[11px]">{name}.gif</figcaption>
			</figure>
		))}
	</div>
</Layout>
