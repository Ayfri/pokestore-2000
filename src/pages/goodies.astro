---
import AddToCart from "../components/AddToCart.svelte";
import ProductArt from "../components/ProductArt.astro";
import { price, products } from "../data";
import Layout from "../layouts/Layout.astro";

const kinds = [...new Set(products.map(product => product.kind))];
---

<Layout title="Boosters & Goodies">
	<p class="mb-3 notice">
		Sealed boosters, theme decks, Game Boy games and more! Cheaper than Toys R Us and we actually HAVE them in stock!!! All boosters come from sealed
		boxes. I do NOT weigh packs, I'm not like that. Pokémon League this Saturday, bring your stamp card!
	</p>
	{kinds.map(kind => (
		<section class="panel mb-3">
			<h3 class="cathead">{kind}</h3>
			<div class="grid grid-cols-2 gap-2 p-2 sm:grid-cols-3 lg:grid-cols-4">
				{products.filter(product => product.kind === kind).map(product => (
					<article class="flex flex-col notice">
						<ProductArt {product} />
						<h4 class="mt-2 font-bold text-navy">{product.name}</h4>
						<p class="flex-1 text-[11px]">{product.description}</p>
						<p class:list={["mt-1 text-[11px] font-bold", product.stock <= 3 ? "text-red-600" : "text-green-700"]}>
							{product.stock <= 3 ? `ONLY ${product.stock} LEFT!!` : `In stock: ${product.stock}`}
						</p>
						<div class="mt-2 flex flex-wrap items-center justify-between gap-1">
							<b class="text-sm text-green-700">{price(product.price)}</b>
							<AddToCart client:idle id={product.id} />
						</div>
					</article>
				))}
			</div>
		</section>
	))}
	<p class="text-center text-[11px] text-gray-600">Video games are NEW in box, not used. Game Boy Color not included. Batteries not included (except the Pokédex).</p>
</Layout>
