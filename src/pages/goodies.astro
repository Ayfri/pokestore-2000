---
import AddToCart from "../components/AddToCart.svelte";
import Gif from "../components/Gif.astro";
import ProductArt from "../components/ProductArt.astro";
import { price, products } from "../data";
import Layout from "../layouts/Layout.astro";

const kinds = [...new Set(products.map(product => product.kind))];
---

<Layout title="Boosters & Goodies">
	<p class="mb-4 border-2 border-dashed border-red-600 bg-white p-2 text-center font-bold">
		<Gif name="pokeball" /> Sealed boosters, theme decks, Game Boy games and more! Cheaper than Toys R Us and we actually HAVE them in stock!!! <Gif name="pokeball" />
	</p>
	<p class="mb-6 text-center text-sm">
		All boosters come from sealed boxes. I do NOT weigh packs, I'm not like that. Pokémon League this Saturday, bring your stamp card!
	</p>
	{kinds.map(kind => (
		<h3 class="mt-8 mb-4 border-b-4 border-double border-navy text-2xl font-bold"><span class="rainbow">{kind}</span></h3>
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{products.filter(product => product.kind === kind).map(product => (
				<article class="box flex flex-col bg-white p-3 text-sm">
					<ProductArt {product} />
					<h4 class="mt-3 text-lg font-bold text-navy">{product.name}</h4>
					<p class="flex-1 text-xs">{product.description}</p>
					<p class:list={["mt-1 text-xs font-bold", product.stock <= 3 ? "animate-blink text-red-600" : "text-green-700"]}>
						{product.stock <= 3 ? `ONLY ${product.stock} LEFT!!` : `In stock: ${product.stock}`}
					</p>
					<div class="mt-2 flex items-center justify-between gap-1">
						<b class="text-lg text-green-700">{price(product.price)}</b>
						<AddToCart client:idle id={product.id} />
					</div>
				</article>
			))}
		</div>
	))}
	<hr />
	<p class="text-center text-xs text-gray-600">Video games are NEW in box, not used. Game Boy Color not included. Batteries not included (except the Pokédex).</p>
</Layout>
