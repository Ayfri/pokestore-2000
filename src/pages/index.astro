---
import { Image } from "astro:assets";
import Gif from "../components/Gif.astro";
import Poll from "../components/Poll.svelte";
import { cards, price } from "../data";
import Layout from "../layouts/Layout.astro";

const featured = cards.find(card => card.id === "base5-4")!;
/** Real release dates of the time, so the site reads like it was updated through 2000. */
const news = [
	["11/05/2000", "Neo Genesis pre-orders are OPEN!!! It comes out 12/16 and the Lugia holo is gonna be HUGE. Email me to reserve a box."],
	["10/15/2000", "Pokémon Gold & Silver are finally out in the USA! I picked Cyndaquil. Oh and Pikablu is real... it's called Marill. :("],
	["09/02/2000", "NEW: Boosters & Goodies page! Sealed packs, theme decks and Game Boy games. Boosters are $3.29, cheaper than the mall!!"],
	["08/27/2000", "Site update: NEW Who's That Pokémon game, a personality quiz, a Downloads page and the Secrets & Rumors page!"],
	["08/14/2000", "Gym Heroes boosters are in stock! Limit 3 per customer, sorry, the store is just me and my mom."],
	["07/21/2000", "Saw Pokémon: The Movie 2000 on opening day!! Got 3 Ancient Mew promo cards. NOT for sale, don't ask."],
	["04/24/2000", "Team Rocket is here! Dark Charizard is the best card ever made, prove me wrong."],
	["02/29/2000", "Pokémon Stadium came out on LEAP DAY. Also Y2K didn't break anything, told you so."],
];
const corner = [
	["Mood", "hyper :D"],
	["Listening to", "Pokémon 2.B.A. Master soundtrack (again)"],
	["Playing", "Pokémon Gold - 5 badges!"],
	["Reading", "Nintendo Power #138"],
	["Best pull this month", "a shadowless holo Chansey from a pack at the dollar store!!!"],
	["Most hated card", "Energy Removal. And Impostor Professor Oak."],
	["Wants", "a Game Boy Color in Atomic Purple for xmas"],
];
---

<Layout title="Your #1 Pokémon Cards Source!">
	<p class="mb-4 text-center"><Gif name="welcome" class="mx-auto" /></p>
	<p class="mb-6 text-center">
		Hi and welcome to <b>Pokéstore 2000</b>, the best place on the World Wide Web for <b>rare Pokémon cards</b>! We sell, buy and TRADE. All cards
		come from my own collection and are kept in sleeves. <a href="/order-info">Click here to learn how to order!</a>
	</p>
	<div class="grid gap-6 md:grid-cols-3">
		<section class="box bg-white md:col-span-2">
			<h3 class="mb-4 text-xl font-bold text-navy"><Gif name="porygon" /> What's New?</h3>
			{news.map(([date, text]) => (
				<p class="mb-3 border-b-2 border-dotted border-silver pb-2"><b class="font-mono text-red-700">[{date}]</b> {text}</p>
			))}
		</section>
		<div class="grid content-start gap-6">
			<section class="box bg-peach text-center">
				<h3 class="mb-2 font-bold"><span class="animate-flame text-white">HOT</span> Card of the Week</h3>
				<a href="/shop">
					<Image src={featured.image} alt={featured.name} width={160} height={223} densities={[1, 2]} format="avif" class="mx-auto mb-2 border-4 border-yellow-400 transition hover:rotate-2" />
				</a>
				<p class="font-bold">{featured.name} ({featured.set})</p>
				<p class="animate-blink font-bold text-red-600">ONLY {price(featured.price)}!</p>
			</section>
			<Poll client:only="svelte" />
		</div>
	</div>
	<p class="my-6 text-center"><Gif name="fire" class="mx-auto max-w-full" /></p>
	<section class="box bg-lilac">
		<h3 class="mb-2 font-bold">★ Webmaster's Corner ★</h3>
		<ul class="text-sm">
			{corner.map(([label, value]) => <li><b>{label}:</b> {value}</li>)}
		</ul>
	</section>
	<div class="mt-6 bg-[repeating-linear-gradient(45deg,#000_0_10px,#ff0_10px_20px)] p-3">
		<p class="bg-cream p-3 text-center text-xl font-bold"><span class="rainbow">Neo Genesis coming 12/16/2000!</span></p>
	</div>
</Layout>
