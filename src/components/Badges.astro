---
/** The wall of 88x31 buttons every homepage had, drawn in CSS so the whole set costs zero requests. Silkscreen at 8px fits about 13 characters per line. */
const badges: [top: string, bottom: string, style: string][] = [
	["Best viewed", "IE 5.0", "border-blue-900 bg-blue-700 text-white"],
	["Made with", "NOTEPAD", "border-gray-500 bg-white text-black"],
	["Get", "WINAMP 2.7", "border-gray-600 bg-gray-800 text-orange-400"],
	["Graphics by", "PAINT SHOP 6", "border-purple-900 bg-purple-700 text-yellow-300"],
];
---

<div class="flex flex-wrap justify-center gap-1">
	{badges.map(([top, bottom, style]) => (
		<span class:list={["badge", style]}><span>{top}</span>{bottom}</span>
	))}
</div>
