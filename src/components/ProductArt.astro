---
/**
 * Shows the real product photo from src/assets/products/<id>.webp (Bulbapedia scans, fetched through the browser since Bulbagarden's
 * Cloudflare blocks scripted downloads). Generic supplies with no photo there get a CSS-drawn box around a sprite.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Product } from "../data";
import Gif from "./Gif.astro";

interface Props {
	product: Product;
}

const { product } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/products/*.webp", { eager: true });
const photo = photos[`../assets/products/${product.id}.webp`]?.default;
---

{photo ? (
	<Image src={photo} alt="" height={192} densities={[1, 2]} format="avif" class="mx-auto h-48 w-auto max-w-full object-contain drop-shadow-[2px_2px_0_#0006]" />
) : (
	<div class="mx-auto flex h-48 w-36 flex-col items-center justify-center gap-3 rounded-lg border-2 border-black/40 bg-sky-800 p-2 text-white">
		<Gif name={product.sprite} class="max-h-20 drop-shadow-[2px_2px_0_#0008]" />
		<span class="text-center text-[11px] leading-tight font-bold [text-shadow:1px_1px_0_#000]">{product.name.toUpperCase()}</span>
	</div>
)}
